{
  "id": "LpRtMain20261010",
  "name": "LeadPilot Retell - Post-call (inactive until verified)",
  "nodes": [
    {
      "id": "setup-notes",
      "name": "Setup Notes",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "parameters": {
        "content": "## Setup before activation\nCredentials: Twilio, Jobber OAuth2 (or client-approved Housecall Pro alternative), Supabase, Slack (in separate error workflow). Configure owner/Twilio E.164 numbers, schema.sql, and Error workflow setting. This webhook MUST have verified Retell raw-body signatures at ingress before activation.\n\nCost: Retell per-minute and Twilio telephony/SMS are billed to the client retainer, not the developer. This post-call workflow has no LLM or voice cost of its own.",
        "width": 520,
        "height": 320
      },
      "position": [
        -240,
        -420
      ]
    },
    {
      "id": "retell-call-end-webhook",
      "name": "Retell Call End Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "parameters": {
        "httpMethod": "POST",
        "path": "retell-call-end",
        "responseMode": "onReceived",
        "options": {}
      },
      "position": [
        0,
        0
      ]
    },
    {
      "id": "parse-call-data",
      "name": "Parse Call Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const envelope = $input.first().json.body ?? $input.first().json;\n  if (envelope.event && envelope.event !== 'call_analyzed') return [];\n  const call = envelope.call ?? envelope;\n  if (!call.call_id || !call.from_number) throw new Error('Retell call_id and from_number are required');\n  const turns = Array.isArray(call.transcript_object) ? call.transcript_object : [];\n  const callerText = turns.filter(t => t.role === 'user').map(t => String(t.content ?? '')).join(' ');\n  const fullText = turns.map(t => String(t.content ?? '')).join(' ') || String(call.transcript ?? '');\n  const analysis = call.call_analysis ?? {};\n  const name = callerText.match(/\\b(?:my name is|this is|i am|i'm)\\s+([a-z]+(?:\\s+[a-z]+)?)/i);\n  const service = fullText.match(/\\b(?:air conditioning|ac repair|hvac|furnace|heating|plumbing|drain|water heater|roofing|roof repair|roof inspection|electrical|garage door|pest control|tree removal)\\b/i);\n  const address = callerText.match(/\\b\\d{1,6}\\s+[a-z0-9.\\s]{3,50}?\\s+(?:street|st|avenue|ave|road|rd|drive|dr|lane|ln|boulevard|blvd)\\b/i);\n  const outOfArea = /\\b(?:outside (?:our|the|your) service area|we do not service (?:that|your) area|out of (?:our|the) service area)\\b/i.test(fullText);\n  const emergency = !/\\b(?:not|no)\\s+(?:an?\\s+)?emergency\\b/i.test(callerText) &&\n    /\\b(?:emergency|urgent|burst pipe|flooding|gas leak|gas odor|smell gas|sparking|smoke|fire|exposed live wiring|no power|no heat|no ac|no air conditioning)\\b/i.test(callerText);\n  const urgency = outOfArea ? 'out_of_area' : emergency ? 'emergency' :\n    (!name || !service) ? 'needs_review' : 'qualified';\n  return [{ json: {\n    call_id: call.call_id, call_status: call.call_status ?? null,\n    from_number: call.from_number, to_number: call.to_number ?? null,\n    start_timestamp: call.start_timestamp ?? null, end_timestamp: call.end_timestamp ?? null,\n    summary: analysis.summary ?? '', in_voicemail: Boolean(analysis.in_voicemail),\n    caller_name: name?.[1]?.trim() ?? 'Unknown caller', service_type: service?.[0] ?? 'Service not specified',\n    address: address?.[0]?.trim() ?? null, urgency, call_outcome: urgency,\n    transcript: String(call.transcript ?? fullText),\n  } }];"
      },
      "position": [
        220,
        0
      ]
    },
    {
      "id": "duplicate-check-supabase-",
      "name": "Duplicate Check (Supabase)",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "parameters": {
        "resource": "row",
        "operation": "getAll",
        "tableId": "retell_call_logs",
        "returnAll": true,
        "filters": {
          "conditions": [
            {
              "keyName": "from_number",
              "condition": "eq",
              "keyValue": "={{ $('Parse Call Data').first().json.from_number }}"
            },
            {
              "keyName": "created_at",
              "condition": "gte",
              "keyValue": "={{ $now.minus({ minutes: 60 }).toISO() }}"
            }
          ]
        },
        "options": {}
      },
      "position": [
        440,
        0
      ],
      "alwaysOutputData": true
    },
    {
      "id": "decide-duplicate",
      "name": "Decide Duplicate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const call = $('Parse Call Data').first().json;\n  const rows = $input.all().map(item => item.json).filter(item => item && item.call_id);\n  const cutoff = Date.now() - 60 * 60 * 1000;\n  const duplicate = rows.some(row => row.call_id === call.call_id ||\n    (row.from_number === call.from_number && Date.parse(row.created_at) >= cutoff));\n  return [{ json: { ...call, duplicate } }];"
      },
      "position": [
        660,
        0
      ]
    },
    {
      "id": "is-duplicate-",
      "name": "Is Duplicate?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.duplicate }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equal"
              }
            }
          ]
        },
        "options": {}
      },
      "position": [
        880,
        0
      ]
    },
