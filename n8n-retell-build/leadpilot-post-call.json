    {
      "id": "jobber-create-client",
      "name": "Jobber Create Client",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "https://api.getjobber.com/api/graphql",
        "authentication": "genericCredentialType",
        "genericAuthType": "oAuth2Api",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-JOBBER-GRAPHQL-VERSION",
              "value": "2026-09-25"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({query: \"mutation CreateClient($input: ClientCreateInput!) { clientCreate(input: $input) { client { id } userErrors { message } } }\", variables: {input:{firstName: $('Parse Call Data').first().json.caller_name.split(' ')[0], lastName: $('Parse Call Data').first().json.caller_name.split(' ').slice(1).join(' ') || 'Caller', phones:[{number:$('Parse Call Data').first().json.from_number, primary:true}]}}}) }}",
        "options": {
          "timeout": 15000
        }
      },
      "position": [
        1320,
        220
      ]
    },
    {
      "id": "assert-jobber-client",
      "name": "Assert Jobber Client",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const response = $input.first().json;\n  const errors = [...(response.errors ?? []), ...(response.data?.clientCreate?.userErrors ?? [])];\n  if (errors.length || !response.data?.clientCreate?.client?.id) {\n    throw new Error(`Jobber clientCreate failed: ${JSON.stringify(errors)}`);\n  }\n  return [{ json: { client_id: response.data.clientCreate.client.id } }];"
      },
      "position": [
        1540,
        220
      ]
    },
