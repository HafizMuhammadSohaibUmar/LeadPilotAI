      "typeVersion": 3,
      "parameters": {
        "mode": "expression",
        "numberOutputs": 4,
        "output": "={{ $json.urgency === 'emergency' ? 0 : ($json.urgency === 'qualified' ? 1 : ($json.urgency === 'out_of_area' ? 2 : 3)) }}",
        "options": {}
